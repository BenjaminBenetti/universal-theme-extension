  },
  "border": {
    "subtle": "#3d444d",
    "strong": "#656c76",
    "accent": "#316dca",
    "danger": "#c93c37",
    "success": "#347d39",
    "warning": "#966600",
    "info": "#316dca"
  },
  "textOnFill": {
    "accent": "#f0f6fc",
    "danger": "#f0f6fc",
    "success": "#f0f6fc",
    "warning": "#f0f6fc",
    "info": "#f0f6fc"
  },
  "interface": {
    "visitedLink": "#986ee2",
    "selection": "#2c589c",
    "selectionText": "#d1d7e0",
    "scrollbarThumb": "#656c76",
    "scrollbarTrack": "#212830"
