{
  "name": "Chrome extension development",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/desktop-lite:1": {}
  },
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "Desktop (noVNC)"
    }
  },
  "runArgs": ["--shm-size=1g", "--security-opt=seccomp=unconfined"]
}
